{
  "name": "timohouse-mockup",
  "private": true,
  "version": "4.0.0",
  "description": "TimoHouse – mockup tương tác cụm Nguồn nhà & tòa/phòng (SRS v1.0 FR02–FR05). Static SPA, vanilla JS ES modules, không build step.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:dist": "node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:parity": "node scripts/check-shell-parity.mjs",
    "test:domain": "node --test \"tests/domain/*.test.mjs\"",
    "verify:screens": "node scripts/verify-screens.mjs",
    "verify:flow": "node scripts/verify-flow.mjs",
    "zip": "npm run build && tar -a -c -f timohouse-mockup.zip -C dist .",
    "render:docs": "node docs_timonouse/outputs/ui-imagegen-v1/_source/render.mjs"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "playwright-core": "^1.63.0"
  }
}
